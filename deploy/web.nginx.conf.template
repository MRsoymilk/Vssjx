map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # Access URLs may contain player-controlled data; do not log them.
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-cache" always;

    # Preserve the original path, Authorization and browser Origin.
    # Never proxy the private monitor listener (9090) or rewrite Origin.
    location ^~ /api/v1/ {
        # Docker Desktop may advertise an unreachable IPv6 host-gateway.
        # Resolve dynamically through Docker DNS and use the reachable IPv4.
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $game_upstream "${SSJX_WEB_UPSTREAM}";
        proxy_pass $game_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ~ /\. { return 404; }

    # Missing game files must be 404, never an HTML fallback masquerading as WASM.
    location ~ "^/assets/[a-f0-9]{16}/" {
        gzip_static on;
        gzip_vary on;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location / {
        gzip_static on;
        gzip_vary on;
        try_files $uri $uri/ =404;
    }
}
