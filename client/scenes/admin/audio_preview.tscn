[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/admin/audio_preview.gd" id="1"]
[node name="AudioPreview" type="VBoxContainer"]
visible = false
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Controls" type="HBoxContainer" parent="."]
theme_override_constants/separation = 8

[node name="Play" type="Button" parent="Controls"]
text = "试听"

[node name="Stop" type="Button" parent="Controls"]
text = "停止"

[node name="Time" type="Label" parent="Controls"]
size_flags_horizontal = 3
horizontal_alignment = 2
text = "0.00 / 0.00 秒"

[node name="Timeline" type="HSlider" parent="."]
step = 0.01
tooltip_text = "拖动定位试听进度"

[node name="Volume" type="HBoxContainer" parent="."]
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="Volume"]
text = "试听音量"

[node name="Slider" type="HSlider" parent="Volume"]
size_flags_horizontal = 3
min_value = -40.0
max_value = 0.0
value = -6.0

[node name="Value" type="Label" parent="Volume"]
custom_minimum_size = Vector2(52, 0)
text = "-6 dB"

[node name="Player" type="AudioStreamPlayer" parent="."]
volume_db = -6.0
