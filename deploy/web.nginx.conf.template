map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # Access URLs may contain player-controlled data; do not log them.
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-cache" always;

    # Preserve the original path, Authorization and browser Origin.
    # Never proxy the private monitor listener (9090) or rewrite Origin.
    location ^~ /api/v1/ {
        proxy_pass ${SSJX_WEB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ~ /\. { return 404; }

    # Missing game files must be 404, never an HTML fallback masquerading as WASM.
    location / {
        try_files $uri $uri/ =404;
    }
}
