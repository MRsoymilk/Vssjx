{
  "world_sync_version": 2,
  "transport": "one WebSocket binary message per authoritative 100ms publication",
  "endian": "big",
  "magic_ascii": "VWD2",
  "header_bytes": 36,
  "header": [
    ["magic", "bytes4"], ["world_stream_id", "uuid_bytes16"], ["seq", "u64"],
    ["enter_json_bytes", "u32"], ["leave_count", "u16"], ["motion_count", "u16"]
  ],
  "body": [
    ["enter", "UTF-8 JSON array of complete public Entity records, length from header"],
    ["leave", "leave_count consecutive u32 net_id values"],
    ["motion", "motion_count consecutive 26-byte records"],
    ["sha256", "bytes32 over every preceding byte of the message"]
  ],
  "motion": [
    ["net_id", "u32"], ["cell", "u16: y*32+x"], ["next_cell", "u16: y*32+x, 65535=null"],
    ["segment_progress", "u16: 0..1000"], ["entity_revision", "u64: 0..i64::MAX"], ["last_input_seq", "u64: 0..i64::MAX"]
  ],
  "limits": {"players": 1000, "message_bytes": 1048576, "retained_publications": 32},
